# Machine-local shell config — sourced at the end of ~/.zshrc.
#
# Keep this file SMALL. `install.sh` seeds it only when it doesn't already
# exist, so anything placed here is frozen on every machine that has already
# run the installer — improvements never propagate. Portable config therefore
# belongs in `zshrc` (which is overwritten on every install), and only two
# kinds of thing belong here:
#
#   1. secrets and credentials, which must stay out of a public repo
#   2. values that genuinely differ between machines
#
# Everything below is guarded, so this file is also safe to leave in place on a
# machine that has none of the relevant tooling installed.

# ============================================
# Credentials
# ============================================
# GitHub Packages auth for the private @telematicahq scope (see os/.npmrc).
# Read from the gh keychain at shell start rather than stored here, so no token
# is ever written to disk. Needs read:packages — run `gh auth refresh -s
# read:packages` once, in a real terminal.
command -v gh >/dev/null && export NODE_AUTH_TOKEN="$(gh auth token 2>/dev/null)"

# ============================================
# Go  (secondary — only active if Go is installed)
# ============================================
if command -v go >/dev/null; then
  export GOPATH="$HOME/go"
  export PATH="$GOPATH/bin:$PATH"
  # Private module paths: never proxy or checksum-verify these. Both casings are
  # listed because Go matches this against the module path exactly as written in
  # go.mod, and GitHub itself is case-insensitive.
  export GOPRIVATE="github.com/telematicaHQ/*,github.com/telematicahq/*"
fi
